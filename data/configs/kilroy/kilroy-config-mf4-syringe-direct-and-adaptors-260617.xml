  	<protocol name = "Cleave">
        <pump duration = "20">Empty</pump>
     	<valve duration = "5">Set TCEP</valve>
    	<pump duration = "900">Flow 2 mL</pump>
        <pump duration = "20">Empty</pump>
     	<valve duration = "5">Set SSC</valve>
    	<pump duration = "420">Flow 2 mL</pump>
        <pump duration = "20">Empty</pump>
    </protocol>
    
