    <!-- 
	speed 200 ~= 833 uL / 10 sec
	1 uL corresponds to 1.2 pump position units
	
	speed 21 corresponds to 0.5 mL / min
	speed 33 corresponds to 1.0 mL / min
	speed 63 corresponds to 1.5 mL / min (fast)
-->


